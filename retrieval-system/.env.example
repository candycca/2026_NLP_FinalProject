# 選擇 LLM 提供者：twcc 或 gemini
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your-uuid-here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- TWCC ---
TWCC_API_KEY=your-uuid-here
TWCC_API_URL=https://api-ams.twcc.ai/api
TWCC_MODEL=llama3.3-ffm-70b-32k-chat
TWCC_TIMEOUT=60
TWCC_MAX_RETRY=2
TWCC_MAX_CONCURRENT=10

#--- batch_size: gemini model每分鐘限制的請求數 ---#
Batch_Size = 15